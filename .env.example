# 네이버 검색광고 API (searchad.naver.com > 도구 > API 사용관리)
NAVER_AD_CUSTOMER_ID=
NAVER_AD_ACCESS_KEY=
NAVER_AD_SECRET_KEY=

# Vercel Cron 인증용 임의의 비밀 문자열 (직접 생성해서 채워넣기)
CRON_SECRET=

# GitHub API로 data/keywords.json을 커밋하기 위한 설정 (Vercel 배포 환경에서만 필요.
# 로컬 next dev에서는 비워두면 기존처럼 로컬 파일에 직접 저장됨)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
